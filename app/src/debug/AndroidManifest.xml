<?xml version="1.0" encoding="utf-8"?>
<!-- debug 专属覆盖：放行本地开发服务端的明文 HTTP（release 走 main 的
     network_security_config：严格 HTTPS + 仅 127.0.0.1 明文豁免，对齐 iOS ATS 策略）。
     main manifest 已声明同名属性，必须 tools:replace 明示覆盖，否则 manifest merger 报冲突。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
