<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />



    <!-- allowBackup=false：token 存 app 私有存储，不进系统备份/迁移。
         networkSecurityConfig：release 严格 HTTPS + 仅 127.0.0.1 明文豁免（本机系统 AI 服务）；
         debug 被 debug/AndroidManifest.xml 的全放行配置 tools:replace 覆盖 -->
    <application
        android:name=".ChunlandApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Chunland">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通用文件分享 provider（拍摄临时文件 / 会话文件用外部应用打开）：只暴露 cache 子目录 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
